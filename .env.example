# ==============================================================================
# AI Data Access & Policy Auditor - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Runtime & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Security & Access Control
# PUBLIC_ACCESS_ENABLE controls whether unauthenticated public users can explore
# the policy registry, inspect cataloged workflows/sources, and run synthetic simulations.
# When true: public read-only viewer mode is enabled for the demo & simulator;
# private audit records, policy mutations, and approval reviews strictly require authentication.
# When false: all endpoints (except health and auth login) require Bearer JWT or Service API Key.
# Accepted values: "true" | "false" (default: "false")
# ------------------------------------------------------------------------------
PUBLIC_ACCESS_ENABLE=false
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-secops
OPERATOR_ADMIN_PASSWORD=admin123!
SERVICE_API_KEY=secops-internal-service-key-production

# ------------------------------------------------------------------------------
# Persistence & Database Strategy
# If MONGODB_URI is provided, persistent storage in MongoDB is used.
# If omitted or unavailable, the backend gracefully utilizes the built-in
# atomic in-memory repository for local development, testing, and CI.
# Audit records are maintained in an immutable cryptographic hash chain and
# never depend on ephemeral local files.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/policy_auditor?authSource=admin

# ------------------------------------------------------------------------------
# Redis Cache & Deduplication (Optional Railway Shared Service)
# Used for evaluation caching, query rate-limiting, and idempotency tracking.
# If omitted or unreachable, backend falls back gracefully to in-memory TTL caching.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Shared Railway AI Platform
# Verified endpoint: POST /api/v1/ai/chat
# Headers: x-api-key: <AI_PLATFORM_API_KEY>
# Payload: { applicationId, tenantId, message, systemInstruction }
# If unreachable or omitted, the backend uses its built-in deterministic
# governance explanation and rationale synthesis engine.
# Note: AI explanation NEVER replaces or alters the deterministic authorization engine!
# ------------------------------------------------------------------------------
AI_PLATFORM_URL=https://ai-platform.onrender.com
AI_PLATFORM_API_KEY=replace-with-ai-platform-service-key

# ------------------------------------------------------------------------------
# Shared Railway Notification Service
# Verified endpoint: POST /v1/notifications
# Headers: x-api-key: <NOTIFICATION_SERVICE_API_KEY>
# Used for dispatching email alerts upon high-risk ESCALATE access decisions
# or policy approval requests submitted to SecOps.
# If omitted or unreachable, backend logs notifications safely to the audit log.
# ------------------------------------------------------------------------------
NOTIFICATION_SERVICE_URL=https://notification-service.onrender.com
NOTIFICATION_SERVICE_API_KEY=replace-with-notification-service-key
ALERT_EMAIL_RECIPIENT=secops-oncall@company.internal

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="AI Data Access & Policy Auditor"
NEXT_PUBLIC_DEFAULT_PUBLIC_ACCESS=false
